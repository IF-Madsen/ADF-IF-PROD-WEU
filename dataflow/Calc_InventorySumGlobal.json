{
	"name": "Calc_InventorySumGlobal",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "InventorySumEU"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "InventorySumUS"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "Items"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "ItemPrices"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "TransitEU"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "TransitUS"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "selectItemFields"
				},
				{
					"name": "RemoveBOM"
				},
				{
					"name": "selectPriceFields"
				},
				{
					"name": "join"
				},
				{
					"name": "joinSummes"
				},
				{
					"name": "SumUpInstockAndSold"
				},
				{
					"name": "SumUpAll"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmSourceBlob as string,",
				"     parmSourceFolder as string",
				"}",
				"source(output(",
				"          ItemNo as string,",
				"          InventorySum as double,",
				"          PurchQty as double,",
				"          SalesQty as double,",
				"          SalesQtyExtCust as double,",
				"          PosAdjustmentQty as double,",
				"          NegAdjustmentQty as double,",
				"          AssemblyOutput as double,",
				"          AssemblyConsumption as double,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'InventorySumEU.parquet',",
				"     compressionCodec: 'snappy') ~> InventorySumEU",
				"source(output(",
				"          ItemNo as string,",
				"          InventorySum as double,",
				"          PurchQty as double,",
				"          SalesQty as double,",
				"          SalesQtyExtCust as double,",
				"          PosAdjustmentQty as double,",
				"          NegAdjustmentQty as double,",
				"          AssemblyOutput as double,",
				"          AssemblyConsumption as double,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'InventorySumUS.parquet',",
				"     compressionCodec: 'snappy') ~> InventorySumUS",
				"source(output(",
				"          ItemNo as string,",
				"          ItemDescription as string,",
				"          GroupDescription as string,",
				"          ItemCategoryGroup as string,",
				"          ItemCategoryCode as string,",
				"          AssemblyBOM as boolean,",
				"          VendorNo as string,",
				"          Name as string,",
				"          Name_2 as string,",
				"          Global_Dimension_1_Filter as string,",
				"          Global_Dimension_2_Filter as string,",
				"          Rank as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'VendorsItemsWithGroupsAll.parquet',",
				"     compressionCodec: 'snappy') ~> Items",
				"source(output(",
				"          ItemNo as string,",
				"          ItemNoAlt as string,",
				"          Description as string,",
				"          UnitPrice as decimal(38,18),",
				"          StandardCost as decimal(38,18),",
				"          Unit_Cost as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'ItemPrices.parquet',",
				"     compressionCodec: 'snappy') ~> ItemPrices",
				"source(output(",
				"          ItemNo as string,",
				"          SumQty as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'PurchItemSumEU.parquet',",
				"     compressionCodec: 'snappy') ~> TransitEU",
				"source(output(",
				"          ItemNo as string,",
				"          SumQty as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'PurchItemSumUS.parquet',",
				"     compressionCodec: 'snappy') ~> TransitUS",
				"RemoveBOM select(mapColumn(",
				"          VendorNo,",
				"          Name,",
				"          ItemNo,",
				"          ItemDescription,",
				"          ItemGroupDescription = GroupDescription",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectItemFields",
				"Items filter(!AssemblyBOM) ~> RemoveBOM",
				"ItemPrices select(mapColumn(",
				"          ItemNo,",
				"          UnitCostPrice = Unit_Cost",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPriceFields",
				"selectItemFields, selectPriceFields join(selectItemFields@ItemNo == selectPriceFields@ItemNo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"InventorySumEU, InventorySumUS join(InventorySumEU@ItemNo == InventorySumUS@ItemNo",
				"     && InventorySumEU@StartDate == InventorySumUS@StartDate",
				"     && InventorySumEU@EndDate == InventorySumUS@EndDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSummes",
				"joinSummes derive(InStockEU = iifNull(InventorySumEU@InventorySum,0),",
				"          InStockUS = iifNull(InventorySumUS@InventorySum,0),",
				"          SoldEU = iifNull(InventorySumEU@SalesQty-InventorySumEU@SalesQtyExtCust,0),",
				"          SoldUS = iifNull(InventorySumUS@SalesQty,0)) ~> SumUpInstockAndSold",
				"SumUpInstockAndSold derive(InStockAll = InStockEU+InStockUS,",
				"          SoldAll = SoldEU+SoldUS) ~> SumUpAll",
				"TransitEU, TransitUS join(TransitEU@ItemNo == TransitUS@ItemNo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'both')~> join1",
				"join1 select(mapColumn(",
				"          ItemNoEU = TransitEU@ItemNo,",
				"          SumQtyEU = TransitEU@SumQty,",
				"          ItemNoUS = TransitUS@ItemNo,",
				"          SumQtyUS = TransitUS@SumQty",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive(ItemNo = iifNull(ItemNoUS,ItemNoEU),",
				"          US_SumQty = iifNull(SumQtyUS,0),",
				"          EU_SumQty = iifNull(SumQtyEU,0)) ~> derivedColumn1",
				"TransitUS, TransitEU join(TransitUS@ItemNo == TransitEU@ItemNo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'both')~> join2",
				"join2 filter(isNull(TransitEU@ItemNo)) ~> filter1",
				"derivedColumn1 select(mapColumn(",
				"          ItemNo,",
				"          US_SumQty,",
				"          EU_SumQty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 union(byName: true)~> union1",
				"filter1 select(mapColumn(",
				"          ItemNo = TransitUS@ItemNo,",
				"          SumQty = TransitUS@SumQty,",
				"          ItemNo = TransitEU@ItemNo,",
				"          SumQty = TransitEU@SumQty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3"
			]
		}
	}
}