{
	"name": "Calc_InventorySumGlobal",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "InventorySumEU"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "InventorySumUS"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "Items"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "ItemPrices"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "TransitEU"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "TransitUS"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SaveGlobalSums"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SaveGlobalItems"
				}
			],
			"transformations": [
				{
					"name": "selectItemFields1"
				},
				{
					"name": "RemoveBOM"
				},
				{
					"name": "selectPriceFields"
				},
				{
					"name": "join"
				},
				{
					"name": "joinSummes"
				},
				{
					"name": "SumUpInstockAndSold"
				},
				{
					"name": "joinTransitRegions"
				},
				{
					"name": "selectTransitFields"
				},
				{
					"name": "allignTransitFields"
				},
				{
					"name": "selectTransitQty"
				},
				{
					"name": "selectItemFields2"
				},
				{
					"name": "selectSumFields"
				},
				{
					"name": "joinSumAndTransit"
				},
				{
					"name": "allignTransitToSum"
				},
				{
					"name": "selectAllFields"
				},
				{
					"name": "SumUpAll"
				},
				{
					"name": "sortOnVendorItems"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmSourceBlob as string ('gold'),",
				"     parmSourceFolder as string ('d365bc'),",
				"     parmTargetBlob as string ('gold'),",
				"     parmTargetFolder as string ('d365bc')",
				"}",
				"source(output(",
				"          ItemNo as string,",
				"          InventorySum as double,",
				"          PurchQty as double,",
				"          SalesQty as double,",
				"          SalesQtyExtCust as double,",
				"          PosAdjustmentQty as double,",
				"          NegAdjustmentQty as double,",
				"          AssemblyOutput as double,",
				"          AssemblyConsumption as double,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'InventorySumEU.parquet',",
				"     compressionCodec: 'snappy') ~> InventorySumEU",
				"source(output(",
				"          ItemNo as string,",
				"          InventorySum as double,",
				"          PurchQty as double,",
				"          SalesQty as double,",
				"          SalesQtyExtCust as double,",
				"          PosAdjustmentQty as double,",
				"          NegAdjustmentQty as double,",
				"          AssemblyOutput as double,",
				"          AssemblyConsumption as double,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'InventorySumUS.parquet',",
				"     compressionCodec: 'snappy') ~> InventorySumUS",
				"source(output(",
				"          ItemNo as string,",
				"          ItemDescription as string,",
				"          GroupDescription as string,",
				"          ItemCategoryGroup as string,",
				"          ItemCategoryCode as string,",
				"          AssemblyBOM as boolean,",
				"          VendorNo as string,",
				"          Name as string,",
				"          Name_2 as string,",
				"          Global_Dimension_1_Filter as string,",
				"          Global_Dimension_2_Filter as string,",
				"          Rank as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'VendorsItemsWithGroupsAll.parquet',",
				"     compressionCodec: 'snappy') ~> Items",
				"source(output(",
				"          ItemNo as string,",
				"          ItemNoAlt as string,",
				"          Description as string,",
				"          UnitPrice as decimal(38,18),",
				"          StandardCost as decimal(38,18),",
				"          Unit_Cost as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'ItemPrices.parquet',",
				"     compressionCodec: 'snappy') ~> ItemPrices",
				"source(output(",
				"          ItemNo as string,",
				"          SumQty as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'PurchItemSumEU.parquet',",
				"     compressionCodec: 'snappy') ~> TransitEU",
				"source(output(",
				"          ItemNo as string,",
				"          SumQty as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: 'PurchItemSumUS.parquet',",
				"     compressionCodec: 'snappy') ~> TransitUS",
				"RemoveBOM select(mapColumn(",
				"          VendorNo,",
				"          Name,",
				"          ItemNo,",
				"          ItemDescription,",
				"          ItemGroupDescription = GroupDescription",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectItemFields1",
				"Items filter(!AssemblyBOM) ~> RemoveBOM",
				"ItemPrices select(mapColumn(",
				"          ItemNo,",
				"          UnitCostPrice = Unit_Cost",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPriceFields",
				"selectItemFields1, selectPriceFields join(selectItemFields1@ItemNo == selectPriceFields@ItemNo,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"InventorySumEU, InventorySumUS join(InventorySumEU@ItemNo == InventorySumUS@ItemNo",
				"     && InventorySumEU@StartDate == InventorySumUS@StartDate",
				"     && InventorySumEU@EndDate == InventorySumUS@EndDate,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSummes",
				"joinSummes derive(InStockEU = iifNull(InventorySumEU@InventorySum,0),",
				"          InStockUS = iifNull(InventorySumUS@InventorySum,0),",
				"          SoldEU = iifNull(InventorySumEU@SalesQty-InventorySumEU@SalesQtyExtCust,0),",
				"          SoldUS = iifNull(InventorySumUS@SalesQty,0),",
				"          ItemNo = iifNull(InventorySumEU@ItemNo, InventorySumUS@ItemNo)) ~> SumUpInstockAndSold",
				"TransitEU, TransitUS join(TransitEU@ItemNo == TransitUS@ItemNo,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'both')~> joinTransitRegions",
				"joinTransitRegions select(mapColumn(",
				"          ItemNoEU = TransitEU@ItemNo,",
				"          SumQtyEU = TransitEU@SumQty,",
				"          ItemNoUS = TransitUS@ItemNo,",
				"          SumQtyUS = TransitUS@SumQty",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> selectTransitFields",
				"selectTransitFields derive(ItemNo = iifNull(ItemNoUS,ItemNoEU),",
				"          US_SumQty = iifNull(SumQtyUS,0),",
				"          EU_SumQty = iifNull(SumQtyEU,0)) ~> allignTransitFields",
				"allignTransitFields select(mapColumn(",
				"          ItemNo,",
				"          US_SumQty,",
				"          EU_SumQty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTransitQty",
				"join select(mapColumn(",
				"          VendorNo,",
				"          Name,",
				"          ItemNo = selectItemFields1@ItemNo,",
				"          ItemDescription,",
				"          ItemGroupDescription,",
				"          UnitCostPrice",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectItemFields2",
				"SumUpInstockAndSold select(mapColumn(",
				"          ItemNo,",
				"          StartDate = InventorySumEU@StartDate,",
				"          EndDate = InventorySumEU@EndDate,",
				"          InStockEU,",
				"          InStockUS,",
				"          SoldEU,",
				"          SoldUS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectSumFields",
				"selectSumFields, selectTransitQty join(selectSumFields@ItemNo == selectTransitQty@ItemNo,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSumAndTransit",
				"joinSumAndTransit derive(TransitEU = iifNull(EU_SumQty,0),",
				"          TransitUS = iifNull(US_SumQty,0),",
				"          ItemNo = iifNull(selectSumFields@ItemNo,selectTransitQty@ItemNo)) ~> allignTransitToSum",
				"allignTransitToSum select(mapColumn(",
				"          ItemNo,",
				"          StartDate,",
				"          EndDate,",
				"          InStockEU,",
				"          InStockUS,",
				"          SoldEU,",
				"          SoldUS,",
				"          TransitEU,",
				"          TransitUS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectAllFields",
				"selectAllFields derive(InStockAll = iifNull(add(InStockEU,InStockUS),0),",
				"          SoldAll = iifNull(add(SoldEU,SoldUS),0),",
				"          TransitAll = iifNull(add(TransitEU,TransitUS),0)) ~> SumUpAll",
				"selectItemFields2 sort(asc(VendorNo, true),",
				"     asc(ItemNo, true)) ~> sortOnVendorItems",
				"SumUpAll sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:['globalSummesAll.parquet'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SaveGlobalSums",
				"sortOnVendorItems sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:['globalItemsAll.parquet'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SaveGlobalItems"
			]
		}
	}
}