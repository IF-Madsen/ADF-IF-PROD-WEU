{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "source2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "source3"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "select1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "filter3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Entry_No as integer,",
				"          Posting_Date as timestamp,",
				"          Entry_Type as string,",
				"          Document_Type as string,",
				"          Document_No as string,",
				"          Document_Line_No as integer,",
				"          Item_No as string,",
				"          Variant_Code as string,",
				"          Description as string,",
				"          Return_Reason_Code as string,",
				"          Global_Dimension_1_Code as string,",
				"          Global_Dimension_2_Code as string,",
				"          Expiration_Date as timestamp,",
				"          Serial_No as string,",
				"          Lot_No as string,",
				"          Package_No as string,",
				"          Location_Code as string,",
				"          Quantity as decimal(38,18),",
				"          RunningBalance as decimal(38,18),",
				"          RunningBalanceLoc as decimal(38,18),",
				"          Invoiced_Quantity as decimal(38,18),",
				"          Remaining_Quantity as decimal(38,18),",
				"          Shipped_Qty_Not_Returned as decimal(38,18),",
				"          Reserved_Quantity as decimal(38,18),",
				"          Qty_per_Unit_of_Measure as decimal(38,18),",
				"          Unit_of_Measure_Code as string,",
				"          Sales_Amount_Expected as decimal(38,18),",
				"          Sales_Amount_Actual as decimal(38,18),",
				"          Cost_Amount_Expected as decimal(38,18),",
				"          Cost_Amount_Actual as decimal(38,18),",
				"          Cost_Amount_Non_Invtbl as decimal(38,18),",
				"          Cost_Amount_Expected_ACY as decimal(38,18),",
				"          Cost_Amount_Actual_ACY as decimal(38,18),",
				"          Cost_Amount_Non_Invtbl_ACY as decimal(38,18),",
				"          Completely_Invoiced as boolean,",
				"          Open as boolean,",
				"          Drop_Shipment as boolean,",
				"          Assemble_to_Order as boolean,",
				"          Applied_Entry_to_Adjust as boolean,",
				"          Order_Type as string,",
				"          Order_No as string,",
				"          Order_Line_No as integer,",
				"          Prod_Order_Comp_Line_No as integer,",
				"          Job_No as string,",
				"          Job_Task_No as string,",
				"          Dimension_Set_ID as integer,",
				"          Shortcut_Dimension_3_Code as string,",
				"          Shortcut_Dimension_4_Code as string,",
				"          Shortcut_Dimension_5_Code as string,",
				"          Shortcut_Dimension_6_Code as string,",
				"          Shortcut_Dimension_7_Code as string,",
				"          Shortcut_Dimension_8_Code as string,",
				"          Source_Type as string,",
				"          Source_No as string,",
				"          Region as string,",
				"          Loaded as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'bronze',",
				"     folderPath: 'd365bc',",
				"     fileName: 'ItemsLedgerEntriesEU.parquet') ~> source1",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'd365bc',",
				"     fileName: 'InventorySumSalesEU.parquet') ~> source2",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'd365bc',",
				"     fileName: 'InventorySumSalesExtCustEU.parquet') ~> source3",
				"source(output(",
				"          ItemNo as string,",
				"          InventorySum as double,",
				"          PurchQty as double,",
				"          SalesQty as double,",
				"          PosAdjustmentQty as double,",
				"          NegAdjustmentQty as double,",
				"          AssemblyOutput as double,",
				"          AssemblyConsumption as double,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'gold',",
				"     folderPath: 'd365bc',",
				"     fileName: 'InventorySumEU.parquet') ~> source4",
				"source1 filter(Item_No=='10510161' && ",
				"(Global_Dimension_1_Code != 'US' &&",
				"Global_Dimension_1_Code != 'CA')) ~> filter1",
				"filter1 sort(asc(Posting_Date, true)) ~> sort1",
				"sort1 select(mapColumn(",
				"          Posting_Date,",
				"          Entry_Type,",
				"          Document_Type,",
				"          Quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source2 filter(Item_No=='15560140') ~> filter2",
				"source4 filter(ItemNo=='22620230') ~> filter3",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'staging',",
				"     folderPath: 'raw',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}