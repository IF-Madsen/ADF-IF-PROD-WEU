{
	"name": "Transform_PurchLineFile",
	"properties": {
		"folder": {
			"name": "2.Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "loadPurchlines"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "savePurchlines",
					"rejectedDataLinkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmRegion as string,",
				"     parmSourceBlob as string,",
				"     parmSourceFolder as string,",
				"     parmTargetBlob as string,",
				"     parmTargetFolder as string,",
				"     parmSourceFilename as string (concat('PurchaseLines',$parmRegion,'.parquet')),",
				"     parmTargetFilename as string (concat('PurchOrderLines',$parmRegion,'.parquet'))",
				"}",
				"source(output(",
				"          Document_Type as string,",
				"          Document_No as string,",
				"          Line_No as integer,",
				"          Type as string,",
				"          FilteredTypeField as string,",
				"          No as string,",
				"          Item_Reference_No as string,",
				"          IC_Partner_Code as string,",
				"          IC_Partner_Ref_Type as string,",
				"          IC_Partner_Reference as string,",
				"          Variant_Code as string,",
				"          Nonstock as boolean,",
				"          Gen_Bus_Posting_Group as string,",
				"          Gen_Prod_Posting_Group as string,",
				"          VAT_Bus_Posting_Group as string,",
				"          VAT_Prod_Posting_Group as string,",
				"          Description as string,",
				"          Description_2 as string,",
				"          Drop_Shipment as boolean,",
				"          Return_Reason_Code as string,",
				"          Location_Code as string,",
				"          Bin_Code as string,",
				"          Quantity as decimal(38,18),",
				"          Reserved_Quantity as decimal(38,18),",
				"          Job_Remaining_Qty as decimal(38,18),",
				"          Unit_of_Measure_Code as string,",
				"          Unit_of_Measure as string,",
				"          Direct_Unit_Cost as decimal(38,18),",
				"          Indirect_Cost_Percent as decimal(38,18),",
				"          Unit_Cost_LCY as decimal(38,18),",
				"          Unit_Price_LCY as decimal(38,18),",
				"          Tax_Liable as boolean,",
				"          Tax_Area_Code as string,",
				"          Tax_Group_Code as string,",
				"          Use_Tax as boolean,",
				"          Line_Discount_Percent as decimal(38,18),",
				"          Line_Amount as decimal(38,18),",
				"          Line_Discount_Amount as decimal(38,18),",
				"          NonDeductibleVATBase as decimal(38,18),",
				"          NonDeductibleVATAmount as decimal(38,18),",
				"          Prepayment_Percent as decimal(38,18),",
				"          Prepmt_Line_Amount as decimal(38,18),",
				"          Prepmt_Amt_Inv as decimal(38,18),",
				"          Allow_Invoice_Disc as boolean,",
				"          Inv_Discount_Amount as decimal(38,18),",
				"          Inv_Disc_Amount_to_Invoice as decimal(38,18),",
				"          Qty_to_Receive as decimal(38,18),",
				"          Quantity_Received as decimal(38,18),",
				"          Qty_to_Invoice as decimal(38,18),",
				"          Quantity_Invoiced as decimal(38,18),",
				"          Prepmt_Amt_to_Deduct as decimal(38,18),",
				"          Prepmt_Amt_Deducted as decimal(38,18),",
				"          Allow_Item_Charge_Assignment as boolean,",
				"          Qty_to_Assign as decimal(38,18),",
				"          Service_Transaction_Type_Code as string,",
				"          Applicable_For_Serv_Decl as boolean,",
				"          Item_Charge_Qty_to_Handle as decimal(38,18),",
				"          Qty_Assigned as decimal(38,18),",
				"          Allocation_Account_No as string,",
				"          Job_No as string,",
				"          Job_Task_No as string,",
				"          Job_Planning_Line_No as integer,",
				"          Job_Line_Type as string,",
				"          Job_Unit_Price as decimal(38,18),",
				"          Job_Line_Amount as decimal(38,18),",
				"          Job_Line_Discount_Amount as decimal(38,18),",
				"          Job_Line_Discount_Percent as decimal(38,18),",
				"          Job_Total_Price as decimal(38,18),",
				"          Job_Unit_Price_LCY as decimal(38,18),",
				"          Job_Total_Price_LCY as decimal(38,18),",
				"          Job_Line_Amount_LCY as decimal(38,18),",
				"          Job_Line_Disc_Amount_LCY as decimal(38,18),",
				"          Requested_Receipt_Date as string,",
				"          Promised_Receipt_Date as string,",
				"          Planned_Receipt_Date as string,",
				"          Expected_Receipt_Date as string,",
				"          Order_Date as string,",
				"          Lead_Time_Calculation as string,",
				"          Planning_Flexibility as string,",
				"          Prod_Order_No as string,",
				"          Prod_Order_Line_No as integer,",
				"          Operation_No as string,",
				"          Work_Center_No as string,",
				"          Finished as boolean,",
				"          Whse_Outstanding_Qty_Base as decimal(38,18),",
				"          Inbound_Whse_Handling_Time as string,",
				"          Blanket_Order_No as string,",
				"          Blanket_Order_Line_No as integer,",
				"          Appl_to_Item_Entry as integer,",
				"          Deferral_Code as string,",
				"          Shortcut_Dimension_1_Code as string,",
				"          Shortcut_Dimension_2_Code as string,",
				"          ShortcutDimCode3 as string,",
				"          ShortcutDimCode4 as string,",
				"          ShortcutDimCode5 as string,",
				"          ShortcutDimCode6 as string,",
				"          ShortcutDimCode7 as string,",
				"          ShortcutDimCode8 as string,",
				"          Over_Receipt_Quantity as decimal(38,18),",
				"          Over_Receipt_Code as string,",
				"          Gross_Weight as decimal(38,18),",
				"          Net_Weight as decimal(38,18),",
				"          Unit_Volume as decimal(38,18),",
				"          Units_per_Parcel as decimal(38,18),",
				"          FA_Posting_Date as string,",
				"          Attached_to_Line_No as integer,",
				"          Attached_Lines_Count as integer,",
				"          CDCIsPurchContract as string,",
				"          CDCPurchContractNo as string,",
				"          CDCPurchContractLineNo as integer,",
				"          CDCPurchContractLineAmount as decimal(38,18),",
				"          AmountBeforeDiscount as decimal(38,18),",
				"          Invoice_Discount_Amount as decimal(38,18),",
				"          Invoice_Disc_Pct as decimal(38,18),",
				"          Total_Amount_Excl_VAT as decimal(38,18),",
				"          Total_VAT_Amount as decimal(38,18),",
				"          Total_Amount_Incl_VAT as decimal(38,18),",
				"          Region as string,",
				"          Loaded as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSourceFilename),",
				"     compressionCodec: 'snappy') ~> loadPurchlines",
				"loadPurchlines select(mapColumn(",
				"          each(match(/* All input columns */true()),",
				"               /* Input name */$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmTargetFilename)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> savePurchlines"
			]
		}
	}
}