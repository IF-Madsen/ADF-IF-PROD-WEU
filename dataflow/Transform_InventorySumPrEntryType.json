{
	"name": "Transform_InventorySumPrEntryType",
	"properties": {
		"description": "Sum on each Itemno for each transactiontype pr. EOM\n",
		"folder": {
			"name": "2.Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "LoadFile",
					"description": "Import data from ItemLedgerEntries D365bcDataLakeProd"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFilePurchV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileTransferV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileNegAdjV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFilePosAdjV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileSalesV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileAssConsV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileAssOutV2"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "WriteFileExtSalesV2"
				}
			],
			"transformations": [
				{
					"name": "OnlyPurchase"
				},
				{
					"name": "SumupQtyPurch"
				},
				{
					"name": "OnlySales"
				},
				{
					"name": "OnlyPosAdjmnt"
				},
				{
					"name": "RemoveFields"
				},
				{
					"name": "SumupPosAdj"
				},
				{
					"name": "SumupSales"
				},
				{
					"name": "sort2"
				},
				{
					"name": "sort3"
				},
				{
					"name": "sort1"
				},
				{
					"name": "OnlyNegAdjmnt"
				},
				{
					"name": "AddEndDate"
				},
				{
					"name": "SumupNegAdj"
				},
				{
					"name": "sort4"
				},
				{
					"name": "OnlyTransfer"
				},
				{
					"name": "SumupQtyTransfer"
				},
				{
					"name": "sort5"
				},
				{
					"name": "OnlyAssCons"
				},
				{
					"name": "SumupAssCons"
				},
				{
					"name": "sort6"
				},
				{
					"name": "OnlyAssOut"
				},
				{
					"name": "SumupAssOut"
				},
				{
					"name": "sort7"
				},
				{
					"name": "sortOnItemNo"
				},
				{
					"name": "excludedItems"
				},
				{
					"name": "OnlyExternSales"
				},
				{
					"name": "SumExtCustomerSales"
				},
				{
					"name": "sort8"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmRegion as string ('EU'),",
				"     parmSourceFile as string (concat('ItemsLedgerEntries',$parmRegion,'.parquet')),",
				"     parmAssOutFile as string (concat('InventorySumAssOut',$parmRegion,'.parquet')),",
				"     parmAssConsFile as string (concat('InventorySumAssCons',$parmRegion,'.parquet')),",
				"     parmTransferFile as string (concat('InventorySumTransfer',$parmRegion,'.parquet')),",
				"     parmNegAdjFile as string (concat('InventorySumNegAdj',$parmRegion,'.parquet')),",
				"     parmPosAdjFile as string (concat('InventorySumPosAdj',$parmRegion,'.parquet')),",
				"     parmSalesFile as string (concat('InventorySumSales',$parmRegion,'.parquet')),",
				"     parmPurchFile as string (concat('InventorySumPurchase',$parmRegion,'.parquet')),",
				"     parmSourceBlob as string ('bronze'),",
				"     parmSourceFolder as string ('d365bc'),",
				"     parmTargetBlob as string ('silver'),",
				"     parmTargetFolder as string ('d365bc'),",
				"     parmExtCustNo as string ('D00482'),",
				"     parmExtCustSalesFile as string (concat('InventorySumSalesExtCust',$parmRegion,'.parquet'))",
				"}",
				"source(output(",
				"          Entry_No as integer,",
				"          Posting_Date as date,",
				"          Entry_Type as string,",
				"          Document_Type as string,",
				"          Document_No as string,",
				"          Document_Line_No as integer,",
				"          Item_No as string,",
				"          Variant_Code as string,",
				"          Description as string,",
				"          Return_Reason_Code as string,",
				"          Global_Dimension_1_Code as string,",
				"          Global_Dimension_2_Code as string,",
				"          Expiration_Date as string,",
				"          Serial_No as string,",
				"          Lot_No as string,",
				"          Package_No as string,",
				"          Location_Code as string,",
				"          Quantity as decimal(38,18),",
				"          RunningBalance as decimal(38,18),",
				"          RunningBalanceLoc as decimal(38,18),",
				"          Invoiced_Quantity as decimal(38,18),",
				"          Remaining_Quantity as decimal(38,18),",
				"          Shipped_Qty_Not_Returned as decimal(38,18),",
				"          Reserved_Quantity as decimal(38,18),",
				"          Qty_per_Unit_of_Measure as decimal(38,18),",
				"          Unit_of_Measure_Code as string,",
				"          Sales_Amount_Expected as decimal(38,18),",
				"          Sales_Amount_Actual as decimal(38,18),",
				"          Cost_Amount_Expected as decimal(38,18),",
				"          Cost_Amount_Actual as decimal(38,18),",
				"          Cost_Amount_Non_Invtbl as decimal(38,18),",
				"          Cost_Amount_Expected_ACY as decimal(38,18),",
				"          Cost_Amount_Actual_ACY as decimal(38,18),",
				"          Cost_Amount_Non_Invtbl_ACY as decimal(38,18),",
				"          Completely_Invoiced as boolean,",
				"          Open as boolean,",
				"          Drop_Shipment as boolean,",
				"          Assemble_to_Order as boolean,",
				"          Applied_Entry_to_Adjust as boolean,",
				"          Order_Type as string,",
				"          Order_No as string,",
				"          Order_Line_No as integer,",
				"          Prod_Order_Comp_Line_No as integer,",
				"          Job_No as string,",
				"          Job_Task_No as string,",
				"          Dimension_Set_ID as integer,",
				"          Shortcut_Dimension_3_Code as string,",
				"          Shortcut_Dimension_4_Code as string,",
				"          Shortcut_Dimension_5_Code as string,",
				"          Shortcut_Dimension_6_Code as string,",
				"          Shortcut_Dimension_7_Code as string,",
				"          Shortcut_Dimension_8_Code as string,",
				"          Source_Type as string,",
				"          Source_No as string,",
				"          Region as string,",
				"          Loaded as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSourceFile),",
				"     compressionCodec: 'snappy') ~> LoadFile",
				"AddEndDate filter(startsWith(Entry_Type,\"Purchase\")) ~> OnlyPurchase",
				"OnlyPurchase aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupQtyPurch",
				"AddEndDate filter(startsWith(Entry_Type,\"Sale\")) ~> OnlySales",
				"AddEndDate filter(startsWith(Entry_Type,\"Positive Adjmt.\")) ~> OnlyPosAdjmnt",
				"sortOnItemNo select(mapColumn(",
				"          Posting_Date,",
				"          Entry_Type,",
				"          Item_No,",
				"          Quantity,",
				"          Region,",
				"          Document_Type,",
				"          Source_Type,",
				"          Source_No",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveFields",
				"OnlyPosAdjmnt aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupPosAdj",
				"OnlySales aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupSales",
				"SumupSales sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort2",
				"SumupPosAdj sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort3",
				"SumupQtyPurch sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort1",
				"AddEndDate filter(startsWith(Entry_Type,\"Negative Adjmt.\")) ~> OnlyNegAdjmnt",
				"RemoveFields derive(EndDate = lastDayOfMonth(Posting_Date)) ~> AddEndDate",
				"OnlyNegAdjmnt aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupNegAdj",
				"SumupNegAdj sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort4",
				"AddEndDate filter(startsWith(Entry_Type,\"Transfer\")) ~> OnlyTransfer",
				"OnlyTransfer aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupQtyTransfer",
				"SumupQtyTransfer sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort5",
				"AddEndDate filter(startsWith(Entry_Type,\"Assembly Consumption\")) ~> OnlyAssCons",
				"OnlyAssCons aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupAssCons",
				"SumupAssCons sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort6",
				"AddEndDate filter(startsWith(Entry_Type,\"Assembly Output\")) ~> OnlyAssOut",
				"OnlyAssOut aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumupAssOut",
				"SumupAssOut sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort7",
				"excludedItems sort(asc(Item_No, true)) ~> sortOnItemNo",
				"LoadFile filter(!isNull(Item_No) &&",
				"!startsWith(Item_No,\"BOX\") && ",
				"!startsWith(Item_No, \"PREBOX\") && ",
				"!startsWith(Item_No, \"ZIP\") && ",
				"!startsWith(Item_No, \"FREIGHT\") &&",
				"!startsWith(Item_No, \"LSGIFTCARD\")) ~> excludedItems",
				"AddEndDate filter(startsWith(Entry_Type,\"Sale\") && ",
				"startsWith(Source_Type, \"Customer\") &&",
				"Source_No == $parmExtCustNo) ~> OnlyExternSales",
				"OnlyExternSales aggregate(groupBy(Region,",
				"          Item_No,",
				"          EndDate),",
				"     Quantity = sum(Quantity)) ~> SumExtCustomerSales",
				"SumExtCustomerSales sort(asc(Item_No, true),",
				"     asc(EndDate, true)) ~> sort8",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmPurchFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> WriteFilePurchV2",
				"sort5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmTransferFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     partitionBy('hash', 1)) ~> WriteFileTransferV2",
				"sort4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmNegAdjFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 3,",
				"     partitionBy('hash', 1)) ~> WriteFileNegAdjV2",
				"sort3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmPosAdjFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 6,",
				"     partitionBy('hash', 1)) ~> WriteFilePosAdjV2",
				"sort2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmSalesFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 7,",
				"     partitionBy('hash', 1)) ~> WriteFileSalesV2",
				"sort6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmAssConsFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 5,",
				"     partitionBy('hash', 1)) ~> WriteFileAssConsV2",
				"sort7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmAssOutFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 4,",
				"     partitionBy('hash', 1)) ~> WriteFileAssOutV2",
				"sort8 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     partitionFileNames:[($parmExtCustSalesFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 8,",
				"     partitionBy('hash', 1)) ~> WriteFileExtSalesV2"
			]
		}
	}
}