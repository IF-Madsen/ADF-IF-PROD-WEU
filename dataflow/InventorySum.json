{
	"name": "InventorySum",
	"properties": {
		"folder": {
			"name": "2.Silver/Test"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetPeriods"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetItems"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetSalesInventSum"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetPurchSum"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetPrimoSum"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetInventAdjustPos"
				},
				{
					"linkedService": {
						"referenceName": "ADFDataLakeStorage",
						"type": "LinkedServiceReference"
					},
					"name": "GetInventAdjustNeg"
				}
			],
			"sinks": [
				{
					"name": "WriteFile2Silver"
				}
			],
			"transformations": [
				{
					"name": "addFields"
				},
				{
					"name": "groupbyItem"
				},
				{
					"name": "removeFields1"
				},
				{
					"name": "joinLedgerPeriods"
				},
				{
					"name": "removeFields2"
				},
				{
					"name": "joinPrimoSum"
				},
				{
					"name": "joinPurchSum"
				},
				{
					"name": "joinSalesSum"
				},
				{
					"name": "removeFields5"
				},
				{
					"name": "updatePrevInvSum"
				},
				{
					"name": "removeFields3"
				},
				{
					"name": "updatePurchSum"
				},
				{
					"name": "removeFields4"
				},
				{
					"name": "updateSalesSum"
				},
				{
					"name": "SumupInventory"
				},
				{
					"name": "RemoveFields6"
				},
				{
					"name": "JoinAdjstPod"
				},
				{
					"name": "join1"
				},
				{
					"name": "Adjustments"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          StartDate as date,",
				"          EndDate as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'bronze',",
				"     folderPath: 'parquet',",
				"     fileName: 'LedgerPeriods.parquet') ~> GetPeriods",
				"source(output(",
				"          ItemNo as string,",
				"          ItemDescription as string,",
				"          ItemCategoryCode as string,",
				"          ItemCategoryGroup as string,",
				"          GroupDescription as string,",
				"          VendorNo as string,",
				"          Name as string,",
				"          Name_2 as string,",
				"          Country_Region_Code as string,",
				"          Currency_Code as string,",
				"          Language_Code as string,",
				"          Location_Code as string,",
				"          Post_Code as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'bronze',",
				"     folderPath: 'parquet',",
				"     fileName: 'ItemsWithGroups.parquet') ~> GetItems",
				"source(output(",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'parquet',",
				"     fileName: 'InventorySumSales.parquet',",
				"     compressionCodec: 'snappy') ~> GetSalesInventSum",
				"source(output(",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'parquet',",
				"     fileName: 'InventorySumPurchase.parquet',",
				"     compressionCodec: 'snappy') ~> GetPurchSum",
				"source(output(",
				"          Item_No as string,",
				"          PrDate as date,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'parquet',",
				"     fileName: 'InitialInventory.parquet',",
				"     compressionCodec: 'snappy') ~> GetPrimoSum",
				"source(output(",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'parquet',",
				"     fileName: 'InventorySumPosAdj.parquet') ~> GetInventAdjustPos",
				"source(output(",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'silver',",
				"     folderPath: 'parquet',",
				"     fileName: 'InventorySumNegAdj.parquet') ~> GetInventAdjustNeg",
				"groupbyItem derive(StartDate = toDate(\"2022-01-01\"),",
				"          InventorySum = 0.0,",
				"          PrevInvetorySum = 0.0,",
				"          PurchQty = 0.0,",
				"          SalesQty = 0.0) ~> addFields",
				"GetItems aggregate(groupBy(ItemNo),",
				"     counter = count()) ~> groupbyItem",
				"addFields select(mapColumn(",
				"          ItemNo,",
				"          counter,",
				"          InventorySum,",
				"          PrevInvetorySum,",
				"          PurchQty,",
				"          SalesQty",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removeFields1",
				"removeFields1, GetPeriods join(toDate(\"2022-01-01\") <= StartDate,",
				"     joinType:'right',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'both')~> joinLedgerPeriods",
				"joinLedgerPeriods select(mapColumn(",
				"          ItemNo,",
				"          InventorySum,",
				"          PrevInventorySum = PrevInvetorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removeFields2",
				"removeFields2, GetPrimoSum join(ItemNo == Item_No",
				"     && StartDate == PrDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPrimoSum",
				"removeFields3, GetPurchSum join(ItemNo == Item_No",
				"     && removeFields3@EndDate == GetPurchSum@EndDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPurchSum",
				"removeFields4, GetSalesInventSum join(ItemNo == Item_No",
				"     && removeFields4@EndDate == GetSalesInventSum@EndDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSalesSum",
				"updateSalesSum select(mapColumn(",
				"          ItemNo,",
				"          InventorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate = removeFields4@EndDate,",
				"          tmpSum",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removeFields5",
				"joinPrimoSum derive(PrevInventorySum = iifNull(Quantity,0)) ~> updatePrevInvSum",
				"updatePrevInvSum select(mapColumn(",
				"          ItemNo,",
				"          InventorySum,",
				"          PrevInventorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removeFields3",
				"joinPurchSum derive(PurchQty = iifNull(Quantity,0) + PrevInventorySum,",
				"          Zero := 0.0) ~> updatePurchSum",
				"updatePurchSum select(mapColumn(",
				"          ItemNo,",
				"          InventorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate = removeFields3@EndDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> removeFields4",
				"joinSalesSum derive(SalesQty = iifNull(Quantity,0),",
				"          tmpSum = 0.0) ~> updateSalesSum",
				"removeFields5 window(over(ItemNo),",
				"     asc(StartDate, true),",
				"     tmpSum = iifNull(lag(InventorySum), 0, lag(InventorySum)),",
				"          InventorySum = sum(tmpSum+PurchQty+SalesQty)) ~> SumupInventory",
				"SumupInventory select(mapColumn(",
				"          ItemNo,",
				"          InventorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveFields6",
				"RemoveFields6, Adjustments join(RemoveFields6@ItemNo == Adjustments@ItemNo",
				"     && RemoveFields6@EndDate == Adjustments@EndDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinAdjstPod",
				"GetInventAdjustPos, GetInventAdjustNeg join(GetInventAdjustPos@Item_No == GetInventAdjustNeg@Item_No",
				"     && GetInventAdjustPos@EndDate == GetInventAdjustNeg@EndDate,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          ItemNo = GetInventAdjustPos@Item_No,",
				"          EndDate = GetInventAdjustPos@EndDate,",
				"          QuantityPos = GetInventAdjustPos@Quantity,",
				"          QuantityNeg = GetInventAdjustNeg@Quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Adjustments",
				"JoinAdjstPod select(mapColumn(",
				"          ItemNo = RemoveFields6@ItemNo,",
				"          InventorySum,",
				"          PurchQty,",
				"          SalesQty,",
				"          StartDate,",
				"          EndDate = RemoveFields6@EndDate,",
				"          QuantityPos,",
				"          QuantityNeg",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['InventorySum.parquet'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1),",
				"     format: 'parquet',",
				"     preCommands: [],",
				"     postCommands: []) ~> WriteFile2Silver"
			]
		}
	}
}