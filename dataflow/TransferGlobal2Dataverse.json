{
	"name": "TransferGlobal2Dataverse",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "GlobalItemParquet"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "GlobalSumsParquet"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Dataverse_ItemForecastGlobalItems",
						"type": "DatasetReference"
					},
					"name": "GlobalItemDataverse",
					"rejectedDataLinkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					}
				},
				{
					"dataset": {
						"referenceName": "Dataverse_ItemForecastGlobalSum",
						"type": "DatasetReference"
					},
					"name": "GlobalSumDataverse"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          VendorNo as string,",
				"          Name as string,",
				"          ItemNo as string,",
				"          ItemDescription as string,",
				"          UnitCostPrice as double,",
				"          ItemCategoryDescription as string,",
				"          ItemCategoryCode as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'gold',",
				"     folderPath: 'd365bc',",
				"     fileName: 'globalItemsAll.parquet',",
				"     compressionCodec: 'snappy') ~> GlobalItemParquet",
				"source(output(",
				"          ItemNo as string,",
				"          StartDate as date,",
				"          EndDate as date,",
				"          InStockEU as double,",
				"          InStockUS as double,",
				"          SoldEU as double,",
				"          SoldUS as double,",
				"          TransitEU as double,",
				"          TransitUS as double,",
				"          ItemCategoryCode as string,",
				"          InStockAll as double,",
				"          SoldAll as double,",
				"          TransitAll as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'gold',",
				"     folderPath: 'd365bc',",
				"     fileName: 'globalSummesAll.parquet') ~> GlobalSumsParquet",
				"GlobalItemParquet sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          cr171_vendornum = VendorNo,",
				"          cr171_vendorname = Name,",
				"          cr171_itemnum = ItemNo,",
				"          cr171_Itemdescription = ItemDescription,",
				"          cr171_costprice = UnitCostPrice,",
				"          cr171_itemcategorydescription = ItemCategoryDescription,",
				"          cr171_itemcategorycode = ItemCategoryCode",
				"     )) ~> GlobalItemDataverse",
				"GlobalSumsParquet sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     mapColumn(",
				"          ItemNo,",
				"          StartDate,",
				"          EndDate,",
				"          InStockEU,",
				"          InStockUS,",
				"          SoldEU,",
				"          SoldUS,",
				"          TransitEU,",
				"          TransitUS,",
				"          ItemCategoryCode,",
				"          InStockAll,",
				"          SoldAll,",
				"          TransitAll",
				"     )) ~> GlobalSumDataverse"
			]
		}
	}
}