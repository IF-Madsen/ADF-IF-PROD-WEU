{
	"name": "TransferGlobal2Dataverse",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "GlobalItemParquet"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "GlobalSumsParquet"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Dataverse_ItemForecastGlobalItems",
						"type": "DatasetReference"
					},
					"name": "GlobalItemDataverse"
				},
				{
					"dataset": {
						"referenceName": "Dataverse_ItemForecastGlobalSum",
						"type": "DatasetReference"
					},
					"name": "GlobalSumDataverse"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'gold',",
				"     folderPath: 'd365bc',",
				"     fileName: 'globalItemsAll.parquet') ~> GlobalItemParquet",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'gold',",
				"     folderPath: 'd365bc',",
				"     fileName: 'globalSummesAll.parquet') ~> GlobalSumsParquet",
				"GlobalItemParquet sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> GlobalItemDataverse",
				"GlobalSumsParquet sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> GlobalSumDataverse"
			]
		}
	}
}