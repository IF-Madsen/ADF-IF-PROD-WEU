{
	"name": "Transform_ItemSumSalesGlobal",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SalesEU"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SalesUS"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "joinSales"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmSalesFileEU as string ('InventorySumSalesEU.parquet'),",
				"     parmSalesFileUS as string ('InventorySumSalesUS.parquet'),",
				"     parmSourceBlob as string,",
				"     parmSourceFolder as string",
				"}",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSalesFileEU)) ~> SalesEU",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSalesFileUS)) ~> SalesUS",
				"SalesEU, SalesUS join(SalesEU@Item_No == SalesUS@Item_No,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSales",
				"joinSales select(mapColumn(",
				"          Item_No = SalesEU@Item_No,",
				"          EndDate = SalesEU@EndDate,",
				"          SalesEU = SalesEU@Quantity,",
				"          EndDate = SalesUS@EndDate,",
				"          SalesUS = SalesUS@Quantity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}