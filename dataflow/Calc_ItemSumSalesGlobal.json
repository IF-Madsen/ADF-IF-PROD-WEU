{
	"name": "Calc_ItemSumSalesGlobal",
	"properties": {
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "EUSales"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "USSales"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "saveGlobalSales"
				}
			],
			"transformations": [
				{
					"name": "unionSales"
				},
				{
					"name": "sortSales"
				},
				{
					"name": "joinSales"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmSalesFileEU as string ('InventorySumSalesEU.parquet'),",
				"     parmSalesFileUS as string ('InventorySumSalesUS.parquet'),",
				"     parmSourceBlob as string ('silver'),",
				"     parmSourceFolder as string ('d365bc'),",
				"     parmTargetBlob as string ('gold'),",
				"     parmTargetFolder as string ('d365bc')",
				"}",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSalesFileEU)) ~> EUSales",
				"source(output(",
				"          Region as string,",
				"          Item_No as string,",
				"          EndDate as date,",
				"          Quantity as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSalesFileUS)) ~> USSales",
				"EUSales, USSales union(byName: false)~> unionSales",
				"unionSales sort(asc(Item_No, true),",
				"     asc(EndDate, true),",
				"     asc(Region, true)) ~> sortSales",
				"USSales, EUSales join(USSales@Item_No == EUSales@Item_No,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSales",
				"sortSales sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:['\\'ItemSumSalesGlobal.parquet\\''],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> saveGlobalSales"
			]
		}
	}
}