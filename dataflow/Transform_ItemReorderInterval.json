{
	"name": "Transform_ItemReorderInterval",
	"properties": {
		"description": "Builds list of Items with each instance of the vaule from the reorder interval.",
		"folder": {
			"name": "2.Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "loadItemFile"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "saveParquetFile"
				}
			],
			"transformations": [
				{
					"name": "selectFields"
				},
				{
					"name": "filterResult"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmSourceBlob as string ('bronze'),",
				"     parmSourceFolder as string ('d365bc'),",
				"     parmTargetBlob as string ('gold'),",
				"     parmTargetFolder as string ('d365bc'),",
				"     parmRegion as string,",
				"     parmSourceFile as string (concat('Items',$parmRegion,'.parquet')),",
				"     parmTargetFile as string (concat('ItemReorder',$parmRegion,'.parquet'))",
				"}",
				"source(output(",
				"          No as string,",
				"          No_270842 as string,",
				"          Description as string,",
				"          Description_264540 as string,",
				"          Description_2 as string,",
				"          Blocked as boolean,",
				"          Type as string,",
				"          Base_Unit_of_Measure as string,",
				"          Last_Date_Modified as timestamp,",
				"          GTIN as string,",
				"          Item_Category_Code as string,",
				"          Manufacturer_Code as string,",
				"          Service_Item_Group as string,",
				"          Automatic_Ext_Texts as boolean,",
				"          Common_Item_No as string,",
				"          Purchasing_Code as string,",
				"          VariantMandatoryDefaultYes as string,",
				"          VariantMandatoryDefaultNo as string,",
				"          Ava_AFC_Transaction_Type as integer,",
				"          Ava_AFC_Service_Type as integer,",
				"          Ava_AFC_Sales_Type as string,",
				"          Ava_VAT_isGoodsSecondHand as boolean,",
				"          Shelf_No as string,",
				"          Created_From_Nonstock_Item as boolean,",
				"          Search_Description as string,",
				"          Inventory as decimal(38,18),",
				"          InventoryNonFoundation as decimal(38,18),",
				"          Qty_on_Purch_Order as decimal(38,18),",
				"          Qty_on_Prod_Order as decimal(38,18),",
				"          Qty_on_Component_Lines as decimal(38,18),",
				"          Qty_on_Sales_Order as decimal(38,18),",
				"          Qty_on_Service_Order as decimal(38,18),",
				"          Qty_on_Job_Order as decimal(38,18),",
				"          Qty_on_Assembly_Order as decimal(38,18),",
				"          Qty_on_Asm_Component as decimal(38,18),",
				"          StockoutWarningDefaultYes as string,",
				"          StockoutWarningDefaultNo as string,",
				"          PreventNegInventoryDefaultYes as string,",
				"          PreventNegInventoryDefaultNo as string,",
				"          Net_Weight as decimal(38,18),",
				"          Gross_Weight as decimal(38,18),",
				"          Unit_Volume as decimal(38,18),",
				"          SAT_Item_Classification as string,",
				"          SAT_Hazardous_Material as string,",
				"          SAT_Packaging_Type as string,",
				"          SAT_Material_Type as string,",
				"          Over_Receipt_Code as string,",
				"          Trans_Ord_Receipt_Qty as decimal(38,18),",
				"          Trans_Ord_Shipment_Qty as decimal(38,18),",
				"          Costing_Method as string,",
				"          Standard_Cost as decimal(38,18),",
				"          Unit_Cost as decimal(38,18),",
				"          Indirect_Cost_Percent as decimal(38,18),",
				"          Last_Direct_Cost as decimal(38,18),",
				"          Net_Invoiced_Qty as decimal(38,18),",
				"          Cost_is_Adjusted as boolean,",
				"          Excluded_from_Cost_Adjustment as boolean,",
				"          Cost_is_Posted_to_G_L as boolean,",
				"          Inventory_Value_Zero as boolean,",
				"          SpecialPurchPriceListTxt as string,",
				"          SpecialPurchPricesAndDiscountsTxt as string,",
				"          Gen_Prod_Posting_Group as string,",
				"          VAT_Prod_Posting_Group as string,",
				"          Tax_Group_Code as string,",
				"          Inventory_Posting_Group as string,",
				"          Default_Deferral_Template_Code as string,",
				"          Tariff_No as string,",
				"          Country_Region_of_Origin_Code as string,",
				"          MID_Code_58500 as string,",
				"          Unit_Price as decimal(38,18),",
				"          CalcUnitPriceExclVAT as decimal(38,18),",
				"          Price_Includes_VAT as boolean,",
				"          Price_Profit_Calculation as string,",
				"          Profit_Percent as decimal(38,18),",
				"          SpecialSalesPriceListTxt as string,",
				"          SpecialPricesAndDiscountsTxt as string,",
				"          Allow_Invoice_Disc as boolean,",
				"          Item_Disc_Group as string,",
				"          Sales_Unit_of_Measure as string,",
				"          Sales_Blocked as boolean,",
				"          Service_Blocked as boolean,",
				"          Application_Wksh_User_ID as string,",
				"          VAT_Bus_Posting_Gr_Price as string,",
				"          Replenishment_System as string,",
				"          Lead_Time_Calculation as string,",
				"          Vendor_No as string,",
				"          Vendor_Item_No as string,",
				"          Purch_Unit_of_Measure as string,",
				"          Purchasing_Blocked as boolean,",
				"          Manufacturing_Policy as string,",
				"          Routing_No as string,",
				"          Production_BOM_No as string,",
				"          Rounding_Precision as decimal(38,18),",
				"          Flushing_Method as string,",
				"          Overhead_Rate as decimal(38,18),",
				"          Scrap_Percent as decimal(38,18),",
				"          Lot_Size as decimal(38,18),",
				"          Assembly_Policy as string,",
				"          AssemblyBOM as boolean,",
				"          Reordering_Policy as string,",
				"          Reserve as string,",
				"          Order_Tracking_Policy as string,",
				"          Stockkeeping_Unit_Exists as boolean,",
				"          Dampener_Period as string,",
				"          Dampener_Quantity as decimal(38,18),",
				"          Critical as boolean,",
				"          Safety_Lead_Time as string,",
				"          Safety_Stock_Quantity as decimal(38,18),",
				"          Include_Inventory as boolean,",
				"          Lot_Accumulation_Period as string,",
				"          Rescheduling_Period as string,",
				"          Reorder_Point as decimal(38,18),",
				"          Reorder_Quantity as decimal(38,18),",
				"          Maximum_Inventory as decimal(38,18),",
				"          Overflow_Level as decimal(38,18),",
				"          Time_Bucket as string,",
				"          Minimum_Order_Quantity as decimal(38,18),",
				"          Maximum_Order_Quantity as decimal(38,18),",
				"          Order_Multiple as decimal(38,18),",
				"          Reorder_Interval_58501 as integer,",
				"          Item_Tracking_Code as string,",
				"          Serial_Nos as string,",
				"          Lot_Nos as string,",
				"          Expiration_Calculation as string,",
				"          Warehouse_Class_Code as string,",
				"          Special_Equipment_Code as string,",
				"          Put_away_Template_Code as string,",
				"          Put_away_Unit_of_Measure_Code as string,",
				"          Phys_Invt_Counting_Period_Code as string,",
				"          Last_Phys_Invt_Date as timestamp,",
				"          Last_Counting_Period_Update as timestamp,",
				"          Next_Counting_Start_Date as timestamp,",
				"          Next_Counting_End_Date as timestamp,",
				"          Identifier_Code as string,",
				"          Use_Cross_Docking as boolean,",
				"          Global_Dimension_1_Filter as string,",
				"          Global_Dimension_2_Filter as string,",
				"          Location_Filter as string,",
				"          Drop_Shipment_Filter as string,",
				"          Variant_Filter as string,",
				"          Lot_No_Filter as string,",
				"          Serial_No_Filter as string,",
				"          Unit_of_Measure_Filter as string,",
				"          Package_No_Filter as string,",
				"          Date_Filter as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSourceFile)) ~> loadItemFile",
				"loadItemFile select(mapColumn(",
				"          ItemNo = No,",
				"          ReorderInterval = Reorder_Interval_58501",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectFields",
				"selectFields filter(!isNull(ItemNo) && ReorderInterval>0) ~> filterResult",
				"filterResult sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> saveParquetFile"
			]
		}
	}
}