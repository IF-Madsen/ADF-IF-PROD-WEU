{
	"name": "Transform_AllPurchLineFiles",
	"properties": {
		"folder": {
			"name": "2.Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "BlanketPurchaseLines"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "PostedPurchaseLines"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "PurchaseLines"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SaveBlanketPOLinesFile",
					"rejectedDataLinkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SavePostedPOLinesFile",
					"rejectedDataLinkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SavePOLinesFile",
					"rejectedDataLinkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "selectBlanketFields"
				},
				{
					"name": "selectPostedFields"
				},
				{
					"name": "selectPurchaseLinesFields"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmRegion as string,",
				"     parmSourceBlob as string,",
				"     parmSourceFolder as string,",
				"     parmTargetBlob as string,",
				"     parmTargetFolder as string,",
				"     parmBlanketPOSourceFile as string (concat('BlanketPurchaseLines',$parmRegion,'.parquet')),",
				"     parmBlanketPOTargetFile as string (concat('BlanketPurchaseLines',$parmRegion,'.parquet')),",
				"     parmPostedPOSourceFile as string (concat('PostedPurchaseLines',$parmRegion,'.parquet')),",
				"     parmPostedPOTargetFile as string (concat('PostedPurchaseLines',$parmRegion,'.parquet')),",
				"     parmPOSourceFile as string (concat('PurchaseLines',$parmRegion,'.parquet')),",
				"     parmPOTargetFile as string (concat('PurchaseLines',$parmRegion,'.parquet'))",
				"}",
				"source(output(",
				"          Document_Type as string,",
				"          Document_No as string,",
				"          Line_No as integer,",
				"          Type as string,",
				"          No as string,",
				"          Item_Reference_No as string,",
				"          Variant_Code as string,",
				"          Gen_Bus_Posting_Group as string,",
				"          Gen_Prod_Posting_Group as string,",
				"          VAT_Bus_Posting_Group as string,",
				"          VAT_Prod_Posting_Group as string,",
				"          Description as string,",
				"          Description_2 as string,",
				"          Location_Code as string,",
				"          Quantity as decimal(38,18),",
				"          Unit_of_Measure_Code as string,",
				"          Unit_of_Measure as string,",
				"          Direct_Unit_Cost as decimal(38,18),",
				"          Indirect_Cost_Percent as decimal(38,18),",
				"          Unit_Cost_LCY as decimal(38,18),",
				"          Unit_Price_LCY as decimal(38,18),",
				"          Tax_Liable as boolean,",
				"          Tax_Area_Code as string,",
				"          Tax_Group_Code as string,",
				"          Use_Tax as boolean,",
				"          Line_Discount_Percent as decimal(38,18),",
				"          Line_Amount as decimal(38,18),",
				"          Line_Discount_Amount as decimal(38,18),",
				"          Allow_Invoice_Disc as boolean,",
				"          Qty_to_Receive as decimal(38,18),",
				"          Quantity_Received as decimal(38,18),",
				"          Quantity_Invoiced as decimal(38,18),",
				"          Expected_Receipt_Date as timestamp,",
				"          Shortcut_Dimension_1_Code as string,",
				"          Shortcut_Dimension_2_Code as string,",
				"          ShortcutDimCode_x005B_3_x005D_ as string,",
				"          ShortcutDimCode_x005B_4_x005D_ as string,",
				"          ShortcutDimCode_x005B_5_x005D_ as string,",
				"          ShortcutDimCode_x005B_6_x005D_ as string,",
				"          ShortcutDimCode_x005B_7_x005D_ as string,",
				"          ShortcutDimCode_x005B_8_x005D_ as string,",
				"          Gross_Weight as decimal(38,18),",
				"          Net_Weight as decimal(38,18),",
				"          Unit_Volume as decimal(38,18),",
				"          Units_per_Parcel as decimal(38,18),",
				"          AmountBeforeDiscount as decimal(38,18),",
				"          Invoice_Discount_Amount as decimal(38,18),",
				"          Invoice_Disc_Pct as decimal(38,18),",
				"          Total_Amount_Excl_VAT as decimal(38,18),",
				"          Total_VAT_Amount as decimal(38,18),",
				"          Total_Amount_Incl_VAT as decimal(38,18)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmSourceFilename),",
				"     compressionCodec: 'snappy') ~> BlanketPurchaseLines",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     fileSystem: '$parmSourceBlob',",
				"     folderPath: '$parmSourceFolder',",
				"     fileName: ($parmPostedPOSourceFile),",
				"     compressionCodec: 'snappy') ~> PostedPurchaseLines",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     fileSystem: '$parmSourceBlob',",
				"     folderPath: '$parmSourceFolder',",
				"     fileName: ($parmPOSourceFile),",
				"     compressionCodec: 'snappy') ~> PurchaseLines",
				"BlanketPurchaseLines select(mapColumn(",
				"          each(match(/* All input columns */true()),",
				"               /* Input name */$$ = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectBlanketFields",
				"PostedPurchaseLines select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPostedFields",
				"PurchaseLines select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectPurchaseLinesFields",
				"selectBlanketFields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmBlanketPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> SaveBlanketPOLinesFile",
				"selectPostedFields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SavePostedPOLinesFile",
				"selectPurchaseLinesFields sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SavePOLinesFile"
			]
		}
	}
}