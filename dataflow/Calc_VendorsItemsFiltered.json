				"          ItemCategoryGroup = toString(byName('ItemCategoryGroup'))) ~> MapDrifted1",
				"joinItemsAndGroups, TopRankVendors join(VendorNo == toString(Vendor_No),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinTopRankVendors",
