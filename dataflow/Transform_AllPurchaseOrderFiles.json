				"PostedPOFields, PurchaseOrders join(Order_No == PurchaseOrders@No,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinPOOnly",
				"JoinPOOnly select(mapColumn(",
				"          Order_No,",
				"          No = PostedPOFields@No,",
				"          Posting_Date = PostedPOFields@Posting_Date,",
				"          Document_Date = PostedPOFields@Document_Date,",
				"          Requested_Receipt_Date = PostedPOFields@Requested_Receipt_Date,",
				"          Promised_Receipt_Date = PostedPOFields@Promised_Receipt_Date,",
				"          Quote_No = PostedPOFields@Quote_No,",
