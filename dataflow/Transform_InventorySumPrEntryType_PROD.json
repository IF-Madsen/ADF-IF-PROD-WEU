				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 3,",
				"     partitionBy('hash', 1)) ~> WriteFileAssCons",
				"sort7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
