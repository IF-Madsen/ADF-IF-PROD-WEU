{
	"name": "Calc_PurchItemsSum",
	"properties": {
		"description": "Sum Items that are in the purchase orders. In-order or In-Transit",
		"folder": {
			"name": "3.Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "PurchaseLines"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "BlanketPurchaseLines"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "PostedPurchaseLines"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SavePurchItemSum"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SaveBlanketPurchSum"
				},
				{
					"linkedService": {
						"referenceName": "D365bcDataLakeProd",
						"type": "LinkedServiceReference"
					},
					"name": "SavePostedPurchItemSum"
				}
			],
			"transformations": [
				{
					"name": "SumTransitItemsQty"
				},
				{
					"name": "RemoveBlanks"
				},
				{
					"name": "SumInOrderItemsQty"
				},
				{
					"name": "RemoveBlanks2"
				},
				{
					"name": "SumPostedItemsQty",
					"description": "Received Items"
				},
				{
					"name": "RemoveBlanks3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     parmRegion as string,",
				"     parmSourceBlob as string,",
				"     parmSourceFolder as string,",
				"     parmTargetBlob as string,",
				"     parmTargetFolder as string,",
				"     parmBlanketPOSourceFile as string (concat('BlanketPurchaseLines',$parmRegion,'.parquet')),",
				"     parmBlanketPOTargetFile as string (concat('BlanketPurchItemSum',$parmRegion,'.parquet')),",
				"     parmPostedPOSourceFile as string (concat('PostedPurchaseLines',$parmRegion,'.parquet')),",
				"     parmPostedPOTargetFile as string (concat('PostedPurchItemSum',$parmRegion,'.parquet')),",
				"     parmPOSourceFile as string (concat('PurchaseLines',$parmRegion,'.parquet')),",
				"     parmPOTargetFile as string (concat('PurchItemSum',$parmRegion,'.parquet'))",
				"}",
				"source(output(",
				"          No as string,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmPOSourceFile),",
				"     compressionCodec: 'snappy') ~> PurchaseLines",
				"source(output(",
				"          No as string,",
				"          Quantity as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmBlanketPOSourceFile),",
				"     compressionCodec: 'snappy') ~> BlanketPurchaseLines",
				"source(output(",
				"          ItemNo as string,",
				"          PurchaseOrderNo as string,",
				"          Qty as double,",
				"          DocumentNo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'parquet',",
				"     fileSystem: ($parmSourceBlob),",
				"     folderPath: ($parmSourceFolder),",
				"     fileName: ($parmPostedPOSourceFile),",
				"     compressionCodec: 'snappy') ~> PostedPurchaseLines",
				"PurchaseLines aggregate(groupBy(No),",
				"     SumQty = sum(Quantity)) ~> SumTransitItemsQty",
				"SumTransitItemsQty filter(No>'' && No!='FREIGHT' && No!='SAMPLES') ~> RemoveBlanks",
				"BlanketPurchaseLines aggregate(groupBy(No),",
				"     Quantity = sum(Quantity)) ~> SumInOrderItemsQty",
				"SumInOrderItemsQty filter(No>'' && No!='FREIGHT' && No!='SAMPLES') ~> RemoveBlanks2",
				"PostedPurchaseLines aggregate(groupBy(ItemNo),",
				"     Quantity = sum(Qty)) ~> SumPostedItemsQty",
				"SumPostedItemsQty filter(ItemNo>'' && ItemNo!='FREIGHT' && ItemNo!='SAMPLES') ~> RemoveBlanks3",
				"RemoveBlanks sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          ItemNo = No,",
				"          SumQty",
				"     ),",
				"     partitionBy('hash', 1)) ~> SavePurchItemSum",
				"RemoveBlanks2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmBlanketPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> SaveBlanketPurchSum",
				"RemoveBlanks3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: ($parmTargetBlob),",
				"     folderPath: ($parmTargetFolder),",
				"     compressionCodec: 'snappy',",
				"     partitionFileNames:[($parmPostedPOTargetFile)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          No = ItemNo,",
				"          Quantity",
				"     ),",
				"     partitionBy('hash', 1)) ~> SavePostedPurchItemSum"
			]
		}
	}
}