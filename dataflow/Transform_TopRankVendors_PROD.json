				"          Vendor_Posting_Group as string,",
				"          Allow_Multiple_Posting_Groups as boolean,",
				"          Gen_Bus_Posting_Group as string,",
				"          VAT_Bus_Posting_Group as string,",
				"          Payment_Terms_Code as string,",
				"          Fin_Charge_Terms_Code as string,",
				"          Currency_Code as string,",
				"          Language_Code as string,",
				"          Search_Name as string,",
				"          Blocked as string,",
				"          Privacy_Blocked as boolean,",
				"          Last_Date_Modified as timestamp,",
				"          Application_Method as string,",
				"          Location_Code2 as string,",
				"          Shipment_Method_Code as string,",
				"          Lead_Time_Calculation as string,",
				"          Base_Calendar_Code as string,",
				"          Balance_LCY as decimal(38,18),",
				"          Balance_Due_LCY as decimal(38,18),",
				"          Payments_LCY as decimal(38,18),",
				"          Coupled_to_CRM as boolean,",
				"          Coupled_to_Dataverse as boolean,",
				"          CDOOutputProfile as string,",
				"          Global_Dimension_1_Filter as string,",
				"          Global_Dimension_2_Filter as string,",
				"          Currency_Filter as string,",
				"          Date_Filter as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'bronze',",
				"     folderPath: 'd365bc',",
				"     fileName: 'Vendors_EU.parquet') ~> Vendors",
				"Items aggregate(groupBy(Vendor_No),",
				"     ItemsRelated = count(Vendor_No)) ~> GroupByVendorNo",
				"GroupByVendorNo sort(desc(ItemsRelated, false)) ~> SortByItemsReleated",
				"Rank filter(Rank<=$vendorrank) ~> TopRanks",
				"SortByItemsReleated keyGenerate(output(Rank as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> Rank",
				"TopRanks, Vendors join(Vendor_No == No,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'json',",
				"     fileSystem: 'silver',",
				"     folderPath: 'json',",
				"     partitionFileNames:['TopRankVendors.json'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> WriteFileJson"
			]
