				"          Global_Dimension_2_Filter as string,",
				"          Location_Filter as string,",
				"          Drop_Shipment_Filter as string,",
				"          Variant_Filter as string,",
				"          Lot_No_Filter as string,",
				"          Serial_No_Filter as string,",
				"          Unit_of_Measure_Filter as string,",
				"          Package_No_Filter as string,",
				"          Date_Filter as string,",
				"          loaded as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'bronze',",
				"     folderPath: 'd365bc',",
				"     fileName: 'Items_EU.parquet') ~> Items",
				"source(output(",
				"          No as string,",
				"          Name as string,",
				"          Name_2 as string,",
				"          Responsibility_Center as string,",
				"          Location_Code as string,",
				"          Post_Code as string,",
