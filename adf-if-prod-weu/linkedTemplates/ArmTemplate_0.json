		{
			"name": "[concat(parameters('factoryName'), '/Calc_InventorySum')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "3.Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "D365bcDataLakeProd",
								"type": "LinkedServiceReference"
							},
							"name": "GetAllLedgerPeriods"
						},
						{
							"linkedService": {
								"referenceName": "D365bcDataLakeProd",
								"type": "LinkedServiceReference"
							},
							"name": "GetItems"
						},
						{
							"linkedService": {
								"referenceName": "D365bcDataLakeProd",
								"type": "LinkedServiceReference"
							},
							"name": "GetInventSumSales"
						},
						{
							"linkedService": {
								"referenceName": "D365bcDataLakeProd",
